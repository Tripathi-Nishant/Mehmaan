# Copy to .env and fill in the blanks. Never commit .env.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://mehmaan:mehmaan@localhost:5432/mehmaan
PUBLIC_BASE_URL=http://localhost:8000

# Gnani Prisma (STT) / Timbre (TTS)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE_HI=
GNANI_TTS_VOICE_EN=
GNANI_DAILY_CALL_CAP=800

# Telegram (BOT_MODE=polling locally, webhook when deployed)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_MODE=polling

# Money + timings (paise / basis points / minutes)
COMMISSION_BPS=1500
MOCK_PAYMENT_SECRET=change-me
HOLD_MINUTES=15
HOST_REPLY_TIMEOUT_MINUTES=720
PAYOUT_DELAY_MINUTES=1440

# Host location pin must be within this many km of the city centre
LOCATION_MAX_KM_FROM_CITY=50

# Traveler emails (STARTTLS). Leave SMTP_HOST empty to keep emails queued, unsent.
# Gmail: smtp.gmail.com + an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Mehmaan TEST <no-reply@example.com>

LOG_LEVEL=INFO

# LLM (Groq, OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
